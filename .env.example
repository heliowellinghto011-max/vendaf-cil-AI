-- SQL de referência para Supabase / Lovable Cloud
-- Crie este esquema no projeto do banco antes de ativar autenticação real.

create table if not exists public.empresas (
  id uuid primary key default gen_random_uuid(),
  nome_empresa text not null,
  created_at timestamptz default now()
);

create table if not exists public.membros (
  id uuid primary key default gen_random_uuid(),
  empresa_id uuid references public.empresas(id) on delete cascade not null,
  user_id uuid not null,
  nome_responsavel text not null,
  papel text default 'responsavel',
  created_at timestamptz default now()
);

create table if not exists public.clientes (
  id uuid primary key default gen_random_uuid(),
  empresa_id uuid references public.empresas(id) on delete cascade not null,
  nome text not null,
  canal_contato text,
  ultima_interacao date,
  observacoes text,
  created_at timestamptz default now(),
  updated_at timestamptz default now()
);

create table if not exists public.oportunidades (
  id uuid primary key default gen_random_uuid(),
  empresa_id uuid references public.empresas(id) on delete cascade not null,
  cliente_id uuid references public.clientes(id) on delete set null,
  nome_cliente text not null,
  produto_servico text not null,
  valor_estimado numeric(12,2) default 0,
  canal_contato text,
  ultimo_atendimento date,
  etapa text not null default 'novo-contato',
  observacoes text,
  motivo_perda text,
  created_at timestamptz default now(),
  updated_at timestamptz default now()
);

create table if not exists public.historico_atividades (
  id uuid primary key default gen_random_uuid(),
  empresa_id uuid references public.empresas(id) on delete cascade not null,
  user_id uuid,
  tipo_entidade text,
  entidade_id uuid,
  acao text,
  detalhes text,
  created_at timestamptz default now()
);

-- Política de exemplo para isolamento por empresa.
-- A associação do usuário à empresa deve ser validada no servidor e/ou via função de segurança.

alter table public.empresas enable row level security;
alter table public.membros enable row level security;
alter table public.clientes enable row level security;
alter table public.oportunidades enable row level security;
alter table public.historico_atividades enable row level security;

create policy "empresas_proprias" on public.empresas
for all using (
  id in (
    select empresa_id from public.membros where user_id = auth.uid()
  )
) with check (
  id in (
    select empresa_id from public.membros where user_id = auth.uid()
  )
);

create policy "membros_proprios" on public.membros
for all using (
  user_id = auth.uid() or empresa_id in (
    select empresa_id from public.membros where user_id = auth.uid()
  )
) with check (
  company_id = any (
    select empresa_id from public.membros where user_id = auth.uid()
  )
);

create policy "clientes_empresa" on public.clientes
for all using (
  empresa_id in (
    select empresa_id from public.membros where user_id = auth.uid()
  )
) with check (
  empresa_id in (
    select empresa_id from public.membros where user_id = auth.uid()
  )
);

create policy "oportunidades_empresa" on public.oportunidades
for all using (
  empresa_id in (
    select empresa_id from public.membros where user_id = auth.uid()
  )
) with check (
  empresa_id in (
    select empresa_id from public.membros where user_id = auth.uid()
  )
);

create policy "historico_empresa" on public.historico_atividades
for all using (
  empresa_id in (
    select empresa_id from public.membros where user_id = auth.uid()
  )
) with check (
  empresa_id in (
    select empresa_id from public.membros where user_id = auth.uid()
  )
);

-- Observação:
-- Será necessário criar uma função RPC ou trigger para garantir que a empresa correta
-- seja atribuída automaticamente ao criar membros, clientes e oportunidades.
